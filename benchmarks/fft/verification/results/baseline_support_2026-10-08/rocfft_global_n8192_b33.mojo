                    var cttw_3_1r = ctg1_r3 * Float32(-0.707106781) - ctg1_i3 * Float32(-0.707106781)
                    var cttw_3_1i = ctg1_r3 * Float32(-0.707106781) + ctg1_i3 * Float32(-0.707106781)
                    var ctf3_r0 = ctg0_r3 + cttw_3_1r
                    var ctf3_i0 = ctg0_i3 + cttw_3_1i
                    var ctf3_r1 = ctg0_r3 - cttw_3_1r
                    var ctf3_i1 = ctg0_i3 - cttw_3_1i
                    var or3 = ctf3_r0
                    var oi3 = ctf3_i0
                    p.output_real_base.store(out_batch_base + (3128 + outer_it * 64), or3)
                    p.output_imag_base.store(out_batch_base + (3128 + outer_it * 64), oi3)

                    var or7 = ctf3_r1
                    var oi7 = ctf3_i1
                    p.output_real_base.store(out_batch_base + (7224 + outer_it * 64), or7)
                    p.output_imag_base.store(out_batch_base + (7224 + outer_it * 64), oi7)


                if True:  # residue 0 chunk 1
                    # ===== stage 4, loop residue 0 chunk offset 4 (width 4) =====
                    var rr0 = p.buf_a.load[width=4](spad_base + (60 + outer_it * 64))
                    var ii0 = p.buf_a.load[width=4](spad_base + 8192 + (60 + outer_it * 64))
                    var rr1 = p.buf_a.load[width=4](spad_base + (1084 + outer_it * 64))
                    var ii1 = p.buf_a.load[width=4](spad_base + 8192 + (1084 + outer_it * 64))
                    var rr2 = p.buf_a.load[width=4](spad_base + (2108 + outer_it * 64))
                    var ii2 = p.buf_a.load[width=4](spad_base + 8192 + (2108 + outer_it * 64))
                    var rr3 = p.buf_a.load[width=4](spad_base + (3132 + outer_it * 64))
                    var ii3 = p.buf_a.load[width=4](spad_base + 8192 + (3132 + outer_it * 64))
                    var rr4 = p.buf_a.load[width=4](spad_base + (4156 + outer_it * 64))
                    var ii4 = p.buf_a.load[width=4](spad_base + 8192 + (4156 + outer_it * 64))
                    var rr5 = p.buf_a.load[width=4](spad_base + (5180 + outer_it * 64))
                    var ii5 = p.buf_a.load[width=4](spad_base + 8192 + (5180 + outer_it * 64))
                    var rr6 = p.buf_a.load[width=4](spad_base + (6204 + outer_it * 64))
                    var ii6 = p.buf_a.load[width=4](spad_base + 8192 + (6204 + outer_it * 64))
                    var rr7 = p.buf_a.load[width=4](spad_base + (7228 + outer_it * 64))
                    var ii7 = p.buf_a.load[width=4](spad_base + 8192 + (7228 + outer_it * 64))

                    # fixed radix-8 butterfly
                    var ctg0_a0r = rr0 + rr4
                    var ctg0_a0i = ii0 + ii4
                    var ctg0_a1r = rr0 - rr4
                    var ctg0_a1i = ii0 - ii4
                    var ctg0_b0r = rr2 + rr6
                    var ctg0_b0i = ii2 + ii6
                    var ctg0_b1r = rr2 - rr6
                    var ctg0_b1i = ii2 - ii6
                    var ctg0_r0 = ctg0_a0r + ctg0_b0r
                    var ctg0_i0 = ctg0_a0i + ctg0_b0i
                    var ctg0_r2 = ctg0_a0r - ctg0_b0r
                    var ctg0_i2 = ctg0_a0i - ctg0_b0i
                    var ctg0_r1 = ctg0_a1r + ctg0_b1i
                    var ctg0_i1 = ctg0_a1i - ctg0_b1r
                    var ctg0_r3 = ctg0_a1r - ctg0_b1i
                    var ctg0_i3 = ctg0_a1i + ctg0_b1r
                    var ctg1_a0r = rr1 + rr5
                    var ctg1_a0i = ii1 + ii5
                    var ctg1_a1r = rr1 - rr5
                    var ctg1_a1i = ii1 - ii5
                    var ctg1_b0r = rr3 + rr7
                    var ctg1_b0i = ii3 + ii7
                    var ctg1_b1r = rr3 - rr7
                    var ctg1_b1i = ii3 - ii7
                    var ctg1_r0 = ctg1_a0r + ctg1_b0r
                    var ctg1_i0 = ctg1_a0i + ctg1_b0i
                    var ctg1_r2 = ctg1_a0r - ctg1_b0r
                    var ctg1_i2 = ctg1_a0i - ctg1_b0i
                    var ctg1_r1 = ctg1_a1r + ctg1_b1i
                    var ctg1_i1 = ctg1_a1i - ctg1_b1r
                    var ctg1_r3 = ctg1_a1r - ctg1_b1i
                    var ctg1_i3 = ctg1_a1i + ctg1_b1r
                    var ctf0_r0 = ctg0_r0 + ctg1_r0
                    var ctf0_i0 = ctg0_i0 + ctg1_i0
                    var ctf0_r1 = ctg0_r0 - ctg1_r0
                    var ctf0_i1 = ctg0_i0 - ctg1_i0
                    var or0 = ctf0_r0
                    var oi0 = ctf0_i0
                    p.output_real_base.store(out_batch_base + (60 + outer_it * 64), or0)
                    p.output_imag_base.store(out_batch_base + (60 + outer_it * 64), oi0)

                    var or4 = ctf0_r1
                    var oi4 = ctf0_i1
                    p.output_real_base.store(out_batch_base + (4156 + outer_it * 64), or4)
                    p.output_imag_base.store(out_batch_base + (4156 + outer_it * 64), oi4)

                    var cttw_1_1r = ctg1_r1 * Float32(0.707106781) - ctg1_i1 * Float32(-0.707106781)
                    var cttw_1_1i = ctg1_r1 * Float32(-0.707106781) + ctg1_i1 * Float32(0.707106781)
                    var ctf1_r0 = ctg0_r1 + cttw_1_1r
                    var ctf1_i0 = ctg0_i1 + cttw_1_1i
                    var ctf1_r1 = ctg0_r1 - cttw_1_1r
                    var ctf1_i1 = ctg0_i1 - cttw_1_1i
                    var or1 = ctf1_r0
                    var oi1 = ctf1_i0
                    p.output_real_base.store(out_batch_base + (1084 + outer_it * 64), or1)
                    p.output_imag_base.store(out_batch_base + (1084 + outer_it * 64), oi1)

                    var or5 = ctf1_r1
                    var oi5 = ctf1_i1
                    p.output_real_base.store(out_batch_base + (5180 + outer_it * 64), or5)
                    p.output_imag_base.store(out_batch_base + (5180 + outer_it * 64), oi5)

                    var cttw_2_1r = ctg1_i2
                    var cttw_2_1i = -ctg1_r2
                    var ctf2_r0 = ctg0_r2 + cttw_2_1r
                    var ctf2_i0 = ctg0_i2 + cttw_2_1i
                    var ctf2_r1 = ctg0_r2 - cttw_2_1r
                    var ctf2_i1 = ctg0_i2 - cttw_2_1i
                    var or2 = ctf2_r0
                    var oi2 = ctf2_i0
                    p.output_real_base.store(out_batch_base + (2108 + outer_it * 64), or2)
                    p.output_imag_base.store(out_batch_base + (2108 + outer_it * 64), oi2)

                    var or6 = ctf2_r1
                    var oi6 = ctf2_i1
                    p.output_real_base.store(out_batch_base + (6204 + outer_it * 64), or6)
                    p.output_imag_base.store(out_batch_base + (6204 + outer_it * 64), oi6)

                    var cttw_3_1r = ctg1_r3 * Float32(-0.707106781) - ctg1_i3 * Float32(-0.707106781)
                    var cttw_3_1i = ctg1_r3 * Float32(-0.707106781) + ctg1_i3 * Float32(-0.707106781)
                    var ctf3_r0 = ctg0_r3 + cttw_3_1r
                    var ctf3_i0 = ctg0_i3 + cttw_3_1i
                    var ctf3_r1 = ctg0_r3 - cttw_3_1r
                    var ctf3_i1 = ctg0_i3 - cttw_3_1i
                    var or3 = ctf3_r0
                    var oi3 = ctf3_i0
                    p.output_real_base.store(out_batch_base + (3132 + outer_it * 64), or3)
                    p.output_imag_base.store(out_batch_base + (3132 + outer_it * 64), oi3)

                    var or7 = ctf3_r1
                    var oi7 = ctf3_i1
                    p.output_real_base.store(out_batch_base + (7228 + outer_it * 64), or7)
                    p.output_imag_base.store(out_batch_base + (7228 + outer_it * 64), oi7)


                outer_it += 1



    @staticmethod
    def writeback():
        ref p = FFTRocfftDefaultM2ndp.params[]
        var gid = global_uthread_id()
        var software_group_id = gid // 8
        var worker_id = gid % 8
        var round_index = Int(FFTRocfftDefaultM2ndp.round_tracker.load[DType.float32, 1](worker_id)[0])
        var round_base = round_index * 32
        var active_groups = 32
        var remaining_blocks = 33 - round_base
        if remaining_blocks < active_groups:
            active_groups = remaining_blocks
        if software_group_id >= active_groups:
            return
        FFTRocfftDefaultM2ndp.round_tracker.store(worker_id, Float32(round_index) + Float32(1))


    @staticmethod
    def device_main():
        launch_parallel[FFTRocfftDefaultM2ndp.stage_0]()
        launch_parallel[FFTRocfftDefaultM2ndp.stage_1]()
        launch_parallel[FFTRocfftDefaultM2ndp.stage_2]()
        launch_parallel[FFTRocfftDefaultM2ndp.stage_3]()
        launch_parallel[FFTRocfftDefaultM2ndp.stage_4]()
        launch_parallel[FFTRocfftDefaultM2ndp.writeback]()
        launch_parallel[FFTRocfftDefaultM2ndp.stage_0]()
        launch_parallel[FFTRocfftDefaultM2ndp.stage_1]()
        launch_parallel[FFTRocfftDefaultM2ndp.stage_2]()
        launch_parallel[FFTRocfftDefaultM2ndp.stage_3]()
        launch_parallel[FFTRocfftDefaultM2ndp.stage_4]()
        launch_parallel[FFTRocfftDefaultM2ndp.writeback]()


def main() raises:
    if FFTRocfftDefaultM2ndp.emit_ir_if_asked():
        return

    var total_elems = 270336
    var input_real = cxl_alloc[Float32](total_elems)
    var input_imag = cxl_alloc[Float32](total_elems)
    var output_real = cxl_alloc[Float32](total_elems)
    var output_imag = cxl_alloc[Float32](total_elems)
    var ref_real = cxl_alloc[Float32](total_elems)
    var ref_imag = cxl_alloc[Float32](total_elems)

    seed(0)
    for i in range(total_elems):
        input_real[i] = Float32(0)
        if i % 8192 == 0:
            input_real[i] = Float32(i // 8192 % 7 + 1)
        input_imag[i] = Float32(0)
        if i % 8192 == 2048:
            input_imag[i] = Float32(0.25)
        output_real[i] = Float32(0)
        output_imag[i] = Float32(0)
        ref_real[i] = Float32(0)
        ref_imag[i] = Float32(0)

    var pool_elems = 2048
    var uthread_pool_raw = cxl_alloc[Float32](pool_elems + 64)
    var uthread_pool_raw_addr = Int(uthread_pool_raw)
    var uthread_pool_addr = (uthread_pool_raw_addr + 255) // 256 * 256
    if uthread_pool_addr % 256 != 0:
        print("[host] pool alignment assertion failed")
        return
    var uthread_pool = UnsafePointer[Float32, MutAnyOrigin](unsafe_from_address=uthread_pool_addr)

    var loop_twiddle_real = cxl_alloc[Float32](26112)
    var loop_twiddle_imag = cxl_alloc[Float32](26112)
    var loop_twiddle_real_hex = String("")
    for tw_idx in range(26112):
        if True:
            var tw_bits = UInt32(0)
            for tw_nibble in range(8):
                var tw_code = Int(loop_twiddle_real_hex.unsafe_ptr()[tw_idx * 16 + 0 + tw_nibble])
                var tw_digit = tw_code & 15
                if tw_code >= 97:
                    tw_digit += 9
                tw_bits = (tw_bits << 4) | UInt32(tw_digit)
            loop_twiddle_real.bitcast[UInt32]()[tw_idx] = tw_bits
        if True:
            var tw_bits = UInt32(0)
            for tw_nibble in range(8):
                var tw_code = Int(loop_twiddle_real_hex.unsafe_ptr()[tw_idx * 16 + 8 + tw_nibble])
                var tw_digit = tw_code & 15
                if tw_code >= 97:
                    tw_digit += 9
                tw_bits = (tw_bits << 4) | UInt32(tw_digit)
            loop_twiddle_imag.bitcast[UInt32]()[tw_idx] = tw_bits
    var buf_a = cxl_alloc[Float32](524288)
    var buf_b = cxl_alloc[Float32](524288)
    var rc = FFTRocfftDefaultM2ndp.launch(
        PooledRange.over(uthread_pool, pool_elems),
        FFTRocfftDefaultM2ndpParams(input_real, input_imag, output_real, output_imag, loop_twiddle_real, loop_twiddle_imag, buf_a, buf_b),
    )

    if rc != 0:
        print("[host] persistent FFT failed, exit", rc)
        return


    for i in range(total_elems):
        var want_real = Float32(i // 8192 % 7 + 1)
        var want_imag = Float32(0)
        if i % 4 == 0:
            want_imag = Float32(0.25)
        elif i % 4 == 1:
            want_real += Float32(0.25)
        elif i % 4 == 2:
            want_imag = Float32(-0.25)
        else:
            want_real -= Float32(0.25)
        if abs(output_real[i] - want_real) > Float32(0.002) or abs(output_imag[i] - want_imag) > Float32(0.002):
            print("[host] FFT mismatch at", i)
            return
    print("[host] large FFT verification passed")
